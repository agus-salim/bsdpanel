#!/bin/sh
#
# PROVIDE: bsdpanel
# REQUIRE: DAEMON NETWORKING
# KEYWORD: shutdown
#
# Add the following line to /etc/rc.conf to enable bsdpanel:
# bsdpanel_enable="YES"

. /etc/rc.subr

name="bsdpanel"
rcvar="bsdpanel_enable"

load_rc_config $name

: ${bsdpanel_enable:="NO"}
: ${bsdpanel_user:="bsdpanel"}
: ${bsdpanel_group:="bsdpanel"}
: ${bsdpanel_config:="/usr/local/etc/bsdpanel.json"}

pidfile="/var/run/${name}.pid"
procname="/usr/local/bin/bsdpanel"
command="/usr/sbin/daemon"
command_args="-c -f -p ${pidfile} -u ${bsdpanel_user} -o /var/log/bsdpanel.log ${procname} -config ${bsdpanel_config}"

start_precmd="bsdpanel_prestart"

bsdpanel_prestart()
{
    # Ensure runtime data directory exists and is owned by daemon user
    if [ ! -d "/var/db/bsdpanel" ]; then
        mkdir -p /var/db/bsdpanel
        chown -R ${bsdpanel_user}:${bsdpanel_group} /var/db/bsdpanel
    fi

    # Ensure log file exists and is writable
    touch /var/log/bsdpanel.log
    chown ${bsdpanel_user}:${bsdpanel_group} /var/log/bsdpanel.log
    chmod 0640 /var/log/bsdpanel.log
}

run_rc_command "$1"
