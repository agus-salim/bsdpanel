#!/bin/sh

# PROVIDE: bsdpanel
# REQUIRE: DAEMON NETWORKING LOGIN
# KEYWORD: shutdown
#
# Tambahkan baris ini ke /etc/rc.conf untuk mengaktifkan bsdpanel:
# bsdpanel_enable="YES"
#
# Variabel opsional:
# bsdpanel_config (path):    Default "/usr/local/etc/bsdpanel/config.json"
# bsdpanel_listen (string):  Default ":8080"
# bsdpanel_user (user):      Default "root"

. /etc/rc.subr

name="bsdpanel"
rcvar="bsdpanel_enable"

load_rc_config $name

: ${bsdpanel_enable:="NO"}
: ${bsdpanel_config:="/usr/local/etc/bsdpanel/config.json"}
: ${bsdpanel_listen:=":8080"}
: ${bsdpanel_user:="root"}

pidfile="/var/run/${name}.pid"
child_pidfile="/var/run/${name}.child.pid"
command="/usr/sbin/daemon"
command_args="-c -r -f -P ${pidfile} -p ${child_pidfile} /usr/local/sbin/bsdpanel -config ${bsdpanel_config} -listen ${bsdpanel_listen}"

start_precmd="bsdpanel_prestart"
stop_postcmd="bsdpanel_poststop"

bsdpanel_prestart()
{
    export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH"
    if [ -f "/usr/local/sbin/bsdpanel.new" ]; then
        chmod 755 /usr/local/sbin/bsdpanel.new
        mv -f /usr/local/sbin/bsdpanel.new /usr/local/sbin/bsdpanel
    fi
    if [ ! -d "/usr/local/etc/bsdpanel" ]; then
        mkdir -p /usr/local/etc/bsdpanel
        chmod 750 /usr/local/etc/bsdpanel
    fi
}

bsdpanel_poststop()
{
    rm -f ${pidfile} ${child_pidfile}
}

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH"

run_rc_command "$1"
