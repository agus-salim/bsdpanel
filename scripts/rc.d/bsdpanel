#!/bin/sh
#
# PROVIDE: bsdpanel
# REQUIRE: DAEMON NETWORKING
# KEYWORD: shutdown
#
# Add the following lines to /etc/rc.conf to enable bsdpanel:
# bsdpanel_enable="YES"
# bsdpanel_config="/usr/local/etc/bsdpanel/panel.yaml"
#

. /etc/rc.subr

name="bsdpanel"
rcvar="bsdpanel_enable"

load_rc_config $name

: ${bsdpanel_enable:="NO"}
: ${bsdpanel_config:="/usr/local/etc/bsdpanel/panel.yaml"}
: ${bsdpanel_user:="root"}

pidfile="/var/run/${name}.pid"
command="/usr/local/sbin/${name}"
command_args="-config ${bsdpanel_config} > /var/log/${name}.log 2>&1 &"

run_rc_command "$1"
